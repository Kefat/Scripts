#!name=𝗖𝗼𝗼𝗸𝗶𝗲 获取
#!desc=iOS Cookies 模块配置.自用

[Script]
# hostname = c.tieba.baidu.com
百度贴吧 = type=http-request, pattern=^https?:\/\/(c\.tieba\.baidu\.com|180\.97\.\d+\.\d+)\/c\/s\/login, script-path=https://gist.githubusercontent.com/blackmatrix7/cebabe7a385fc6a9ad32e2f7a35851dc/raw/1363d8720c92267d0a97fcd8eb98673760891fc9/tieba_min.js, timeout=60
百度贴吧 = type=http-request, pattern=^https?:\/\/c\.tieba\.baidu\.com\/c\/s\/channelIconConfig, script-path=https://gist.githubusercontent.com/blackmatrix7/cebabe7a385fc6a9ad32e2f7a35851dc/raw/1363d8720c92267d0a97fcd8eb98673760891fc9/tieba_min.js, timeout=60

# hostname = m.client.10010.com
中国联通组件 = type=http-request, pattern=https:\/\/m\.client\.10010\.com\/(.*)\/smartwisdomCommon, script-path=https://raw.githubusercontent.com/dompling/Script/master/10010/index.js, timeout=60
中国联通组件 = type=http-request, pattern=https:\/\/m(?:xx)?\.client\.10010\.com\/(?:.*\/)?smartwisdomCommon(?:New)?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/dompling/Script/master/10010/index.js, requires-body=true, max-size=0, script-update-interval=0

# hostname = tm-web.pin-dao.cn
微信-奈雪点单 = type=http-request, pattern=^https:\/\/tm-web\.pin-dao\.cn\/user\/base-userinfo, script-path=https://gist.githubusercontent.com/Sliverkiss/4d0e9572b99530b7cb0e7298622aa2a9/raw/naixue.js, requires-body=true, max-size=-1, timeout=60

# hostname = api.hellobike.com
支付宝-哈啰单车 = type=http-request, pattern=^https:\/\/api\.hellobike\.com\/api\?user\.taurus\.pointInfo, script-path=https://gist.githubusercontent.com/Sliverkiss/4e0081f7b18a2cea9dbdf13545e60885/raw/d53857028ced29aed98affb5d4a602b2a8bf94cf/hldc.js, requires-body=true, max-size=-1, timeout=60

# hostname = xmc.ximalaya.com
喜马拉雅 = type=http-request, pattern=^https?:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\/, script-path=https://raw.githubusercontent.com/ClydeTime/Quantumult/main/Script/Task/xmlySign.js, timeout=60

# hostname = api.weibo.cn
微博 = type=http-request, pattern=^https:\/\/m?api\.weibo\.c(n|om)\/\d\/users\/show, script-path=https://raw.githubusercontent.com/Kefat/Scripts/main/weibo.js, timeout=60

# hostname = *.amap.com
高德地图 = type=http-request, pattern=^https:\/\/m?api\.weibo\.c(n|om)\/\d\/users\/show, script-path=https://raw.githubusercontent.com/Kefat/Scripts/main/weibo.js, timeout=60

[MITM]
hostname = %APPEND% c.tieba.baidu.com, m.client.10010.com, tm-web.pin-dao.cn, api.hellobike.com, xmc.ximalaya.com, api.weibo.cn, *.amap.com
